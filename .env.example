# Optional comma-separated A-share symbols.
# Shanghai uses .SS; Shenzhen uses .SZ.
# Leave empty to generate index context without a stock watchlist.
WATCH_TICKERS=
ENABLE_CFTC_GOLD=1
ENABLE_MACRO_CONTEXT=1

# Optional ignored local JSON file for forward earnings dates.
# Copy earnings_calendar.example.json and keep the populated file out of Git.
EARNINGS_CALENDAR_PATH=

# Optional TradingAgents market-context adapter.
TA_VENV=
TA_RUN_WEBUI_TOOLS=
TA_CWD=
